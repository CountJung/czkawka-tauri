{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Web (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4000",
      "webRoot": "${workspaceFolder}/ui/src",
      "sourceMapPathOverrides": {
        "~/src/*": "${workspaceFolder}/ui/src/*"
      },
      "preLaunchTask": "debug:web"
    },
    {
      "name": "Debug Tauri (WebView)",
      "type": "msedge",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/ui/src",
      "sourceMapPathOverrides": {
        "~/src/*": "${workspaceFolder}/ui/src/*"
      },
      "preLaunchTask": "dev"
    }
  ]
}
